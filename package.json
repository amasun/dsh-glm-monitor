{
  "name": "dsh-glm-monitor",
  "version": "1.0.0",
  "description": "GLM usage monitor for DeepSeek Harness: Zhipu AI subscription quota in the right sidebar",
  "keywords": ["deepseek-harness", "dsh-plugin", "zhipu", "bigmodel", "glm", "usage-monitor"],
  "author": "amasun",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/amasun/dsh-glm-monitor" },
  "engines": { "node": ">=20.12" },
    "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
